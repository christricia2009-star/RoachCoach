# Copy this file to .env and fill in real values. Never commit the real .env file.
# You mentioned you'll hardcode keys later once ready — this file is the map of
# every variable the code actually reads, so nothing gets missed.

DATABASE_URL=postgresql://user:password@localhost:5432/foodtrucks

# ---------- CloudKit bridge (only needed if using CloudKit instead of
# Postgres as your data store — see cloudkit_bridge.py) ----------
CLOUDKIT_CONTAINER_ID=iCloud.com.yourbundleid.RoachCoachRadar
CLOUDKIT_KEY_ID=your_key_id_here
CLOUDKIT_PRIVATE_KEY_PATH=/path/to/your/cloudkit_private_key.pem
CLOUDKIT_ENVIRONMENT=development

# ---------- Scheduler (Backend/scheduler.py) ----------
HOME_BASE_LATITUDE=38.5816
HOME_BASE_LONGITUDE=-121.4944

# ---------- LLM Provider (caption parsing) ----------
# LLM_STRATEGY: single | round_robin | fallback
#   single      — always uses LLM_PROVIDER below
#   round_robin — rotates across every provider that has a key set, to
#                 spread load across free/cheap tiers
#   fallback    — tries providers in order, moving on if one errors out
LLM_STRATEGY=single
LLM_PROVIDER=anthropic
# Optional override — defaults to a cheap model per provider if left blank
# (see Backend/scraping/llm_providers.py DEFAULT_MODELS). Verify current
# model names/pricing before relying on defaults long-term.
LLM_MODEL=

ANTHROPIC_API_KEY=your_key_here
XAI_API_KEY=your_key_here
OPENROUTER_API_KEY=your_key_here

# ---------- Social APIs ----------
# Instagram API with Instagram Login (token starts with IGA) — free for
# the Instagram professional account that generated the token (Tester
# role, development mode). Put the token AND the numeric IG user id
# (from GET /me?fields=user_id). Business Discovery of *other* food
# truck accounts is NOT available on Instagram Login tokens; that needs
# a Facebook Login Page token (EAA…) plus App Review.
INSTAGRAM_ACCESS_TOKEN=your_token_here
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_ig_user_id_here
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Facebook Login user token (starts with EAA). Required to list OTHER
# Instagram professional accounts via Business Discovery (@drewskis,
# @sactomofo, …) and to read Facebook business pages. The Instagram
# Login IGA… token cannot do this. Also needs Meta App Review.
FACEBOOK_USER_ACCESS_TOKEN=
FACEBOOK_PAGE_ACCESS_TOKEN=

# X (Twitter) API — no free tier as of Feb 2026, pay-per-use
# ($0.005/read, $0.015/post created). Budget accordingly even for testing.
X_API_BEARER_TOKEN=your_token_here

# ---------- Direct data partnerships ----------
# Generic slot for whatever partnership feed(s) you already have lined up
# (truck associations, POS vendors, regional networks, etc). Fill in once
# you have the partner's real credentials + endpoint docs.
PARTNERSHIP_API_KEY=your_key_here
PARTNERSHIP_API_BASE_URL=https://partner-api-base-url.example.com

# ---------- Public/partner: public municipal open data (no partnership needed —
# just find your city's real dataset URL, see Backend/collectors/municipal_open_data.py) ----------
MUNICIPAL_DATASET_URL=
MUNICIPAL_APP_TOKEN=

# ---------- Public/partner: telecom cell-tower signal data (requires your carrier
# agreement — see Backend/collectors/telecom_signal_data.py) ----------
TELECOM_API_KEY=your_key_here
TELECOM_API_BASE_URL=https://your-carrier-partner-endpoint.example.com

# ---------- Public/partner: delivery-app pickup pins (requires your Uber/DoorDash
# partnerships — see Backend/collectors/delivery_pickup_pins.py) ----------
UBER_PARTNER_CLIENT_ID=your_client_id_here
UBER_PARTNER_CLIENT_SECRET=your_client_secret_here
UBER_PARTNER_API_BASE_URL=https://your-uber-partner-endpoint.example.com

DOORDASH_PARTNER_API_KEY=your_key_here
DOORDASH_PARTNER_API_BASE_URL=https://your-doordash-partner-endpoint.example.com

# ---------- Public/partner: California traffic cameras (Backend/collectors/
# california_camera_directory.py) — no keys needed, this is a public
# Caltrans feed. Listed here only as a reminder it exists. ----------
# No .env variables required for this one.

# ---------- Storage ----------
# S3-compatible bucket for storing crowdsourced sighting photos
S3_BUCKET_NAME=your_bucket_name
AWS_ACCESS_KEY_ID=your_key
AWS_SECRET_ACCESS_KEY=your_secret
